{
  "name": "angkorev-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "AngkorEV \u2014 multi-tenant, evidence-based car marketplace for Cambodia",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "tsx scripts/init-db.ts && tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.5",
    "@fontsource/noto-sans-khmer": "5.2.5",
    "@libsql/client": "^0.15.15",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.44.7",
    "lucide-react": "0.468.0",
    "next": "15.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.10.2",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "dotenv": "16.4.7",
    "tailwindcss": "4.1.14",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "3.2.4"
  }
}
